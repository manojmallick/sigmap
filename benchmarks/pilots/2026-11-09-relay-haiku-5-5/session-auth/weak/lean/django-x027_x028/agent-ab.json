      "Glob",
      "Bash"
    ],
    "corpus": "benchmarks/tasks/retrieval-xrepo.jsonl",
    "selection": "the task id(s) x027, x028",
    "passDefinition": "hit@5 on the repository-relative paths the answer names",
    "priceAsOf": "2026-10-04",
    "publishable": false,
